<%= form_with(model: chat, url: chats_path) do |form| %>
<%= form.hidden_field :claim_id %>
  <% if chat.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(chat.errors.count, "error") %> prohibited this chat from being saved:</h2>

      <ul>
        <% chat.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div style="margin-top: 15px;">
    <%= form.text_field :prompt, style: "width: 100%; max-width: 600px;", placeholder: "What would you like to discuss?", autofocus: true %>
  </div>

  <div>
    <%= form.submit "Start new chat" %>
  </div>
<% end %>
