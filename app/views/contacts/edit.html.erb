<% content_for :title, "Edit contact" %>

<main class="container my-5" style="max-width: 720px;">
  <%= render "shared/back_link", fallback_path: contact_path(@contact), label: @contact.name %>
  <section class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mt-4">
    <p class="text-primary small text-uppercase fw-semibold mb-2">Address book</p>
    <h1 class="h2 fw-bold mb-2">Edit contact</h1>
    <p class="text-muted mb-4">Keep this contact’s information accurate and up to date.</p>
    <%= render "form", contact: @contact %>
  </section>
</main>
