<section class="mt-5" aria-labelledby="dashboard-properties-heading">
  <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
    <div>
      <div class="text-muted small text-uppercase fw-semibold">Your homes</div>
    </div>
    <%= link_to new_property_path, class: "btn btn-primary" do %>
      <i class="fa-solid fa-building me-1" aria-hidden="true"></i> Add property
    <% end %>
  </div>

  <% if properties.any? %>
    <div class="row g-3">
      <% properties.each do |property| %>
        <div class="col-md-6">
          <%= link_to property_path(property), class: "card h-100 border-0 shadow-sm text-decoration-none property-dashboard-card" do %>
            <div class="card-body p-4 d-flex align-items-center gap-3">
              <span class="property-dashboard-card__icon"><i class="fa-solid fa-building"></i></span>
              <span class="flex-grow-1 min-width-0">
                <strong class="d-block text-dark"><%= property.address.presence || "Property ##{property.id}" %></strong>
                <small class="text-muted"><%= pluralize(property.claims.active.count, "active claim") %></small>
              </span>
              <i class="fa-solid fa-arrow-right text-primary" aria-hidden="true"></i>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card border-0 shadow-sm"><div class="card-body p-4 text-muted">No properties yet. Add your first property to get started.</div></div>
  <% end %>
</section>
