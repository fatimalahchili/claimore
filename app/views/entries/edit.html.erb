<% content_for :title, "Edit #{@entry.title}" %>

<main class="container my-5" style="max-width: 760px;">
  <%= render "shared/back_link", fallback_path: entry_path(@entry), label: "Entry details" %>

  <section class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mt-4">
    <p class="text-primary small text-uppercase fw-semibold mb-2">Claim #<%= @entry.claim_id %> · Timeline</p>
    <h1 class="h2 fw-bold mb-2">Edit entry</h1>
    <p class="text-muted mb-4">Update the timeline record while keeping the original claim history intact.</p>
    <%= render "form", entry: @entry %>
  </section>
</main>
