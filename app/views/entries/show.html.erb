<div class="container my-5" style="max-width: 760px;">
  <%= link_to claim_path(@entry.claim), class: "text-decoration-none text-muted small fw-semibold" do %>
    <i class="fa-solid fa-arrow-left me-1"></i> Back to claim timeline
  <% end %>

  <article class="card border-0 shadow-sm p-4 p-md-5 mt-4 rounded-4 timeline-entry <%= entry_status_classes(@entry.status) %>">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <p class="text-primary small fw-semibold mb-2">Claim #<%= @entry.claim_id %> · Timeline entry</p>
        <h1 class="h3 fw-bold mb-0"><%= @entry.title %></h1>
      </div>
      <% if @entry.status.present? %>
        <span class="badge bg-white text-dark border text-capitalize px-3 py-2"><%= @entry.status %></span>
      <% end %>
    </div>

    <dl class="row border-top border-bottom py-3 mb-4">
      <dt class="col-sm-3 text-muted">Date</dt>
      <dd class="col-sm-9"><%= @entry.date&.strftime("%B %d, %Y") || @entry.created_at.strftime("%B %d, %Y") %></dd>
      <dt class="col-sm-3 text-muted">Category</dt>
      <dd class="col-sm-9 mb-0"><%= @entry.category.presence || "Not specified" %></dd>
    </dl>

    <h2 class="h6 fw-bold">Details</h2>
    <p class="text-secondary mb-4"><%= @entry.description.presence || "No description was provided." %></p>

    <div class="d-flex gap-2">
      <%= link_to "Edit entry", edit_entry_path(@entry), class: "btn btn-outline-primary" %>
      <%= button_to "Delete entry", entry_path(@entry), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Delete this entry?" } %>
    </div>
  </article>
</div>
