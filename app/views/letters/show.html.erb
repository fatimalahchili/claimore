<div class="container my-5">
  <div class="card p-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2><%= @letter.title %></h2>
      <span class="badge bg-secondary">Sent on: <%= @letter.sent_on || "Not sent yet" %></span>
    </div>

    <hr>

    <div class="my-4">
      <h5>Content:</h5>
      <p class="text-muted"><%= simple_format(@letter.summary) %></p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to "Back to Claim", claim_path(@letter.claim), class: "btn btn-outline-primary" %>
      <% if @letter.pdf.attached? %>
        <%= link_to "Download PDF", cloudinary_url(@letter.pdf.key, disposition: "attachment"), class: "btn btn-outline-secondary" %>
      <% end %>
      <%= button_to "Delete Letter", letter_path(@letter), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger" %>
    </div>
  </div>
</div>
