<% assistant ||= local_assigns[:message] %>
<div id="message_<%= assistant.id %>" class="chat-bubble-row chat-bubble-row--assistant" data-controller="typing-indicator">
  <span class="chat-widget__blob chat-widget__blob--xs" aria-hidden="true">
    <span class="chat-widget__eye"></span><span class="chat-widget__eye"></span>
  </span>
  <div class="chat-bubble chat-bubble--assistant">
    <div class="chat-bubble__typing" data-typing-indicator-target="dots">
      <span></span><span></span><span></span>
    </div>
    <div id="message_<%= assistant.id %>_content" data-typing-indicator-target="content"><%= assistant.content %></div>
  </div>
</div>
