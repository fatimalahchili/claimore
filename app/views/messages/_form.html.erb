<% chat ||= @chat %>
<%= form_with(model: message, url: [chat, message], id: "new_message", class: "chat-widget__form") do |form| %>
  <%= form.text_field :content, placeholder: "Ask me anything…", autocomplete: "off", autofocus: true, class: "chat-widget__input" %>
  <button type="submit" class="chat-widget__send" aria-label="Send message">
    <i class="fa-solid fa-paper-plane"></i>
  </button>
<% end %>
