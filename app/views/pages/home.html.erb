<!-- Hero Section -->
<section class="home-hero py-5 text-center">
  <div class="container py-4">
    <div class="home-hero__eyebrow d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill">
      <i class="fa-solid fa-sparkles"></i> AI-Powered Housing & Tenancy Assistant
    </div>

    <h1 class="home-hero__title display-4 fw-bold text-dark mb-3">
      Resolve Housing Disputes & Repairs with <span>Claimore</span>
    </h1>

    <p class="home-hero__copy lead text-muted mb-4 mx-auto">
      Log property maintenance issues, generate legally sound notices, and track landlord response deadlines effortlessly.
    </p>

    <div class="d-flex justify-content-center gap-3">
      <%= link_to new_claim_path, class: "btn btn-primary btn-lg px-4 shadow-sm fw-semibold d-inline-flex align-items-center gap-2" do %>
        <span>Start a New Claim</span>
        <i class="fa-solid fa-arrow-right"></i>
      <% end %>
      <%= link_to timeline_claims_path, class: "btn btn-outline-secondary btn-lg px-4 fw-semibold" do %>
        <span>View Claim Timeline</span>
      <% end %>
    </div>
  </div>
</section>

<!-- Issue Categories / Problem Cards -->
<section class="home-issues py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold text-dark">Common Issues Claimore Resolves</h2>
      <p class="text-muted">Structured evidence logs and legally compliant templates for all major tenancy problems.</p>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm">
          <div class="home-issue-icon home-issue-icon--blue mb-3"><i class="fa-solid fa-droplet" aria-hidden="true"></i></div>
          <h5 class="fw-bold">Water Damage & Leaks</h5>
          <p class="text-muted small">Burst pipes, ceiling leaks, or broken plumbing. Automatically calculate statutory emergency repair windows.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm">
          <div class="home-issue-icon home-issue-icon--amber mb-3"><i class="fa-solid fa-temperature-high" aria-hidden="true"></i></div>
          <h5 class="fw-bold">Heating & Boiler Failure</h5>
          <p class="text-muted small">Loss of heating or hot water in winter conditions. Instant urgent notice generation with tenant rights references.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm">
          <div class="home-issue-icon home-issue-icon--green mb-3"><i class="fa-solid fa-wind" aria-hidden="true"></i></div>
          <h5 class="fw-bold">Mold, Damp & Ventilation</h5>
          <p class="text-muted small">Persistent damp, black mold, or faulty extractor fans with photo evidence logs and habitability tracking.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- How it Works Section -->
<section class="py-5 bg-white">
  <div class="container py-4">
    <div class="text-center mb-5">
      <h2 class="fw-bold text-dark">How Claimore Works in 3 Steps</h2>
      <p class="text-muted">From the first complaint to official resolution.</p>
    </div>

    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="p-3">
          <div class="home-step badge bg-primary text-white rounded-circle p-3 mb-3 fs-4">1</div>
          <h5 class="fw-bold">Log Your Issue</h5>
          <p class="text-muted small">Choose your problem category, add photos, messages, and property details in seconds.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="p-3">
          <div class="home-step badge bg-primary text-white rounded-circle p-3 mb-3 fs-4">2</div>
          <h5 class="fw-bold">AI Drafts Formal Notices</h5>
          <p class="text-muted small">Generate professional follow-up letters and emails citing relevant tenant protection laws.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="p-3">
          <div class="home-step badge bg-primary text-white rounded-circle p-3 mb-3 fs-4">3</div>
          <h5 class="fw-bold">Track Deadlines</h5>
          <p class="text-muted small">Follow statutory response windows and keep a tamper-proof chronological evidence timeline.</p>
        </div>
      </div>
    </div>
  </div>
</section>
