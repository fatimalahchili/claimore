<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
          <h1 class="h3 fw-bold mb-1">Add property</h1>
          <p class="text-muted mb-4">Enter the address and your move-in date.</p>
          <%= simple_form_for @property do |f| %>
            <%= f.error_notification %>
            <%= f.input :address, required: true, input_html: { autocomplete: "street-address" } %>
            <%= f.input :moved_on, as: :date, label: "Move-in date", required: false %>
            <div class="d-flex gap-2 mt-4">
              <%= f.button :submit, "Create property", class: "btn btn-primary" %>
              <%= link_to "Cancel", dashboard_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
