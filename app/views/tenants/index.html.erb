<div class="container my-5" style="max-width: 960px;">
  <%= render "shared/back_link", fallback_path: property_path(@property), label: @property.address.presence || "Property" %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h2 class="fw-bold text-dark mb-0">Tenants</h2>
    <%= link_to "Add Tenant", new_property_tenant_path(@property), class: "btn btn-primary" %>
  </div>

  <% if @tenants.any? %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @tenants.each do |tenant| %>
            <tr>
              <td><%= tenant.user.email %></td>
              <td class="text-capitalize"><%= tenant.role.to_s.humanize %></td>
              <td>
                <span class="badge rounded-pill px-3 py-2 text-uppercase <%= tenant_status_classes(tenant.status) %>"><%= tenant.status %></span>
              </td>
              <td class="text-end">
                <%= link_to "Edit", edit_tenant_path(tenant), class: "btn btn-sm btn-outline-secondary" %>
                <%= button_to "Remove", tenant_path(tenant), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Remove this tenant?" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-5">
      <h6 class="fw-semibold">No tenants yet</h6>
      <p class="text-muted small">Add the first tenant for this property.</p>
      <%= link_to "Add Tenant", new_property_tenant_path(@property), class: "btn btn-sm btn-primary" %>
    </div>
  <% end %>
</div>
